---
import BaseLayout from "../layouts/BaseLayout.astro";
import GithubIcon from "../../public/github.svg";
import TelegramIcon from "../../public/telegram.svg";
import TwitterXIcon from "../../public/twitter-x.svg";
---

<BaseLayout>
  <main class="w-full max-w-7xl py-12">
    <section class="w-full max-w-2xl">
      <article>
        <h1 class="mb-10 text-3xl font-bold">
          <a
            href="https://github.com/Rebix"
            class="text-rose-pine-text hover:text-rose-pine-foam flex items-end gap-2 no-underline!"
            target="_blank"
          >
            <GithubIcon class="size-9" />
            <span>@Rebix</span>
          </a>
        </h1>
        <section aria-label="Biography">
          <h2
            class="border-rose-pine-highlight-high text-rose-pine-iris mb-4 border-b pb-2 text-xl font-bold"
          >
            Bio
          </h2>
          <p>
            I'm Sina, a full-stack developer and someone who genuinely enjoys
            making software. I've been building for the web for over 7 years,
            working across everything from interfaces and backend systems to
            deployment and infrastructure.
          </p>
          <p>
            These days I mostly work with React, Next.js, TypeScript, and
            Django, but I'm more interested in solving problems than being tied
            to a particular stack. I like learning how new technologies work,
            experimenting with them, and finding practical ways to use them.
          </p>
          <p>
            I share my work, my experiments, and anything interesting I discover
            along the way here.
          </p>
        </section>
        <section aria-label="latest work">
          <h2 class="text-rose-pine-iris mt-10 mb-4 text-xl font-bold">
            Latest work
          </h2>
          <article
            class="border-rose-pine-pine bg-rose-pine-surface border-l-2 px-4 py-3"
          >
            <h3>
              <a
                href="https://github.com/Rebix/bse-ecommerce"
                target="_blank"
                class="mb-2 block"
              >
                BSE Ecommerce
              </a>
            </h3>
            <p class="text-sm">
              A full-stack ecommerce platform with device-based product
              discovery, OTP authentication, payments, order processing, and a
              separate service for synchronizing external product catalogs.
            </p>
            <p class="text-rose-pine-gold text-sm">
              Next.js &bull; TypeScript &bull; Django &bull; PostgreSQL &bull;
              Docker
            </p>
            <p class="flex items-center gap-x-2 text-sm">
              <a href="https://github.com/Rebix/bse-ecommerce">
                Main repository
              </a>
              <span aria-hidden="true">&bull;</span>
              <a href="https://github.com/Rebix/bse-catalog-sync">
                Catalog service
              </a>
            </p>
          </article>
        </section>
        <section aria-label="beliefs">
          <h2 class="text-rose-pine-iris mt-10 mb-4 text-xl font-bold">
            Things I believe in
          </h2>
          <ul class="marker:text-rose-pine-love list-disc pl-8">
            <li>
              <h3 class="text-rose-pine-rose">
                Complexity must earn its place.
              </h3>
              <p class="text-rose-pine-subtle text-sm">
                Simple systems are easier to understand, change, and trust. I
                add complexity when the problem demands it.
              </p>
            </li>
            <li>
              <h3 class="text-rose-pine-rose">
                Understand the whole thing, not just your part of it.
              </h3>
              <p class="text-rose-pine-subtle text-sm">
                I like knowing how the pieces connect, from the interface to the
                infrastructure.
              </p>
            </li>
            <li>
              <h3 class="text-rose-pine-rose">
                Question assumptions. Verify what actually happens.
              </h3>
              <p class="text-rose-pine-subtle text-sm">
                I'd rather test, measure, and understand than rely on
                assumptions.
              </p>
            </li>
            <li>
              <h3 class="text-rose-pine-rose">
                Technology is a tool, not an identity.
              </h3>
              <p class="text-rose-pine-subtle text-sm">
                Choose the tool that fits the problem, not just the one that
                feels familiar or comfortable to me.
              </p>
            </li>

            <li>
              <h3 class="text-rose-pine-rose">Reliable beats clever.</h3>
              <p class="text-rose-pine-subtle text-sm">
                I’d rather build something boring that works every day.
              </p>
            </li>
          </ul>
        </section>
        <!-- <section> -->
        <!--   <h2 class="mt-10 mb-4 text-xl font-bold">Blogs</h2> -->
        <!--   <ul> -->
        <!--     <li>No blog posts yet...</li> -->
        <!--   </ul> -->
        <!-- </section> -->
        <section aria-label="contact">
          <h2 class="text-rose-pine-iris mt-10 mb-4 text-xl font-bold">
            Have something in mind?
          </h2>
          <a href="mailto:itsrebix@proton.me">Get in touch</a>
          <div class="mt-10 flex items-end gap-4">
            <a
              href="https://github.com/Rebix"
              aria-label="github"
              class="flex items-center gap-1"
            >
              <GithubIcon class="size-7" />
            </a>
            <span class="text-rose-pine-muted" aria-hidden="true">&bull;</span>
            <a
              href="https://t.me/theRebix"
              aria-label="telegram"
              class="flex items-center gap-1"
            >
              <TelegramIcon class="size-7" />
            </a>
            <span class="text-rose-pine-muted" aria-hidden="true">&bull;</span>
            <a
              href="https://x.com/theRebix"
              aria-label="X"
              class="flex items-center gap-1"
            >
              <TwitterXIcon class="size-7" />
            </a>
          </div>
        </section>
      </article>
    </section>
  </main>
</BaseLayout>
